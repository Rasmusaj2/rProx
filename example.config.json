{
    "proxy": {
        "listenHost": "127.0.0.1",
        "listenPort": 25565,
        "targetHost": "mc.hypixel.net",
        "targetPort": 25565,
        "version": "1.8.9",
        "motd": "\u00a7brProx \u00a72| \u00a76Hypixel Stats Proxy.",
        "onlineMode": true,
        "maxPlayers": 10
    },
    "auth": {
        "dir": "./auth",
        "requireMatchingAccount": true
    },
    "commandPrefix": "//",
    "detection": {
        "autoWhoOnStart": true,
        "ignoreSelf": false
    },
    "builtInPlugins": {
        "hypixelStats": {
            "enabled": true,
            "apiKey": "",
            "cacheTtlSeconds": 300
        },
        "nametagStats": {
            "enabled": true,
            "aboveHead": true,
            "tablist": true,
            "maxTablistPlayers": 32,
            "cacheTtlSeconds": 120
        },
        "dailyRewards": {
            "enabled": true,
            "mode": "chat",
            "prefer": [],
            "timeoutMs": 10000
        }
    },
    "pluginDirectory": "./plugins"
}