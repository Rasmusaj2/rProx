{
    "proxy": {
        "listenHost": "127.0.0.1",
        "listenPort": 25565,
        "targetHost": "mc.hypixel.net",
        "targetPort": 25565,
        "version": "1.8.9",
        "motd": "\u00a7brProx \u00a72| \u00a76Hypixel Stats Proxy.",
        "onlineMode": true,
        "maxPlayers": 10
    },
    "auth": {
        "dir": "./auth",
        "requireMatchingAccount": true
    },
    "commandPrefix": "//",
    "detection": {
        "autoWhoOnStart": true,
        "ignoreSelf": false
    },
    "builtInPlugins": {
        "hypixelStats": {
            "enabled": true,
            "apiKey": "",
            "cacheTtlSeconds": 300
        },
        "nametagStats": {
            "enabled": true,
            "aboveHead": true,
            "tablist": true,
            "maxTablistPlayers": 32,
            "cacheTtlSeconds": 120
        },
        "dailyRewards": {
            "enabled": true,
            "mode": "chat",
            "prefer": [],
            "timeoutMs": 10000
        },
        "lobbyFishing": {
            "enabled": true,
            "sidebar": true,
            "maxSidebarLines": 15,
            "spacer": true,
            "hideRows": ["hypixel level"],
            "colors": {
                "total": "green",
                "fish": "yellow",
                "plant": "dark_green",
                "mythical": "gold",
                "treasure": "aqua",
                "junk": "gray",
                "creature": "light_purple"
            },
            "mythical": {
                "enabled": true,
                "bossBar": true,
                "debug": false,
                "bar": "heat",
                "bossBarMode": "replace",
                "bossEntity": "dragon",
                "heatPerClick": 10,
                "heatDecayPerSecond": 15,
                "heatMax": 100,
                "safeHeat": 70
            }
        },
        "antiAfk": {
            "enabled": false,
            "intervalSeconds": 150,
            "prefix": "[AFK] ",
            "charset": "abcdefghijklmnopqrstuvwxyz0123456789",
            "messageLength": 16,
            "hideMessages": true,
            "autoStart": true,
            "targetUser": null
        }
    },
    "pluginDirectory": "./plugins"
}