{
  "name": "rProx",
  "version": "0.1.0",
  "description": "A Hypixel Stat Checking proxy inspired by Lilith & Starfish.",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "rProx": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "minecraft-protocol": "^1.47.0",
    "prismarine-auth": "^2.5.0",
    "prismarine-chat": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
